# Copy to .env for docker compose / local gateway.
ENGRAM_DB_URL_TEMPLATE=postgresql://postgres:engram@127.0.0.1:5432/__DB__

# TypeSafe Jev — typed decisions. Leave empty to fail open.
TYPESAFE_API_KEY=
REFLEX_MODEL=jev-latest
REFLEX_MIN_CONFIDENCE=0.55

# Voyage embeddings for gbrain candidate generation.
VOYAGE_API_KEY=
ENGRAM_EMBEDDING_MODEL=voyage:voyage-4-large
ENGRAM_EMBEDDING_DIMENSIONS=1024

# Resend — magic-link and invite email. Leave empty to show the link in the console.
RESEND_API_KEY=
ENGRAM_MAIL_FROM=engram@updates.ani.computer

# WorkOS AuthKit — Claude / ChatGPT / Grok connectors. Leave empty to keep those closed.
ENGRAM_PUBLIC_URL=https://engram.ani.computer
ENGRAM_OAUTH_ISSUER=
ENGRAM_OAUTH_AUDIENCE=https://engram.ani.computer/mcp
ENGRAM_OAUTH_JWKS_URL=
