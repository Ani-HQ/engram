# Docker Compose quickstart. Generate a secret with: openssl rand -hex 32
# Replace the placeholder; use URL-safe hex for the database connection URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_64_CHARACTER_HEX_SECRET
ENGRAM_RUNTIME_DB_PASSWORD=REPLACE_WITH_ANOTHER_GENERATED_64_CHARACTER_HEX_SECRET
ENGRAM_TENANT_CREDENTIAL_KEY=REPLACE_WITH_ANOTHER_GENERATED_64_CHARACTER_HEX_SECRET

# Compose always runs without billing in self-hosted mode.
ENGRAM_DEPLOYMENT_MODE=self-hosted
# Hosted deployments default to invite-only; self-hosted installs default to open.
# ENGRAM_SIGNUP_MODE=invite-only
ENGRAM_BIND_ADDRESS=127.0.0.1
ENGRAM_PORT=8080
ENGRAM_PUBLIC_URL=http://localhost:8080

# Local HTTP only. Set 0 when serving through an HTTPS reverse proxy.
# The actual variable is singular: ENGRAM_INSECURE_COOKIE.
ENGRAM_INSECURE_COOKIE=1

# Keep 0 on shared or public installations. For isolated development only,
# setting 1 exposes email-login links to the caller when mail is unconfigured.
# Hosted mode never permits that fallback.
ENGRAM_DEV_LOGIN_LINKS=0

# Optional email provider. Without it, use the owner bootstrap CLI for sign-in;
# public signup/login does not reveal magic links.
RESEND_API_KEY=
ENGRAM_MAIL_FROM=engram@example.com

# Optional Jev decisions: supply your own key, then opt in to Jev in Workspace.
# A key does not enable processing for a workspace by itself.
JEV_API_KEY=
# Legacy aliases REFLEX_API_KEY and TYPESAFE_API_KEY are still accepted.
REFLEX_API_KEY=
REFLEX_MODEL=jev-latest
# Embeddings and generated briefs have separate external-AI consent.
VOYAGE_API_KEY=

# Optional first-party OAuth for chat connectors; bearer-token MCP needs no key.
# Use an RSA private key and an audience matching your canonical HTTPS URL /mcp.
ENGRAM_OAUTH_PRIVATE_KEY=
ENGRAM_OAUTH_AUDIENCE=

# Native gateway installs need this separately (Compose constructs its own URL).
# ENGRAM_DB_URL_TEMPLATE=postgresql://engram_gateway_runtime:RUNTIME_PASSWORD@127.0.0.1:5432/__DB__
# ENGRAM_PROVISIONER_DB_URL_TEMPLATE=postgresql://postgres:PROVISIONER_PASSWORD@127.0.0.1:5432/__DB__
# ENGRAM_TENANT_CREDENTIAL_KEY=YOUR_SEPARATE_32_BYTE_OR_LONGER_KEY

# Native self-hosting runs trusted GBrain processes. For a contained Linux setup,
# use docker workers on a dedicated internal Docker network with the DB/proxy.
# ENGRAM_WORKER_ISOLATION=docker
# ENGRAM_WORKER_IMAGE=engram:release
# ENGRAM_WORKER_NETWORK=engram-workers
# Hosted Cloud Run requires its sandbox launcher and a dedicated SQL connector
# identity. Process mode and shared database credentials are rejected in hosted.
# ENGRAM_WORKER_ISOLATION=cloudrun
# ENGRAM_WORKER_CONNECTOR_SERVICE_ACCOUNT=engram-db-connector@PROJECT.iam.gserviceaccount.com

# Optional generative handoff provider; no unrelated server API key is reused.
ENGRAM_BRIEF_API_KEY=
ENGRAM_BRIEF_MODEL=
